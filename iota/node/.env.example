# For mainnet, start from `.env.mainnet.example` instead of this file.

# IOTA Network
IOTA_RPC_URL=https://api.testnet.iota.cafe

# Coordinator Contract
COORDINATOR_PACKAGE_ID=0x...
COORDINATOR_OBJECT_ID=0x...

# Fastcrypto CLI
# Build the vendored, pinned CLI with:
#   cd ../fastcrypto && cargo build --locked --release --bin ecvrf-cli
FASTCRYPTO_CLI_PATH=../fastcrypto/target/release/ecvrf-cli

# VRF proving key (env wins over command, command wins over path)
VRF_SECRET_KEY=
VRF_PUBLIC_KEY=
VRF_KEYPAIR_PATH=./vrf-keypair.json
VRF_KEYPAIR_COMMAND=

# Operator signer (env wins over command, command wins over path)
OPERATOR_PRIVATE_KEY=
OPERATOR_KEYPAIR_PATH=./operator-keypair.json
OPERATOR_KEY_COMMAND=

# Local state
STATE_DIR=./state

# Ops server
# Docker keeps ops private by default; use docker-compose.public-ops.yml to publish.
OPS_HOST=127.0.0.1
OPS_PORT=9464

# Polling Configuration
POLL_INTERVAL_MS=500
BACKFILL_WINDOW_SEC=30
EVENT_PAGE_SIZE=50
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RPC_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
RPC_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Demo helpers
DEMO_CONSUMER_OBJECT_ID=
DEMO_SUBSCRIPTION_FUND_AMOUNT=
DEMO_SEED_TEXT=kamui-testnet-demo
DEMO_SEED_HEX=
DEMO_CALLBACK_TEXT=round-1
DEMO_CALLBACK_HEX=
DEMO_NUM_WORDS=1
DEMO_WAIT_TIMEOUT_MS=60000
DEMO_POLL_INTERVAL_MS=1000
DEMO_MEASURE_ITERATIONS=5
DEMO_MEASURE_SETTLE_MS=250
DEMO_MEASURE_SEED_TEXT=kamui-latency
DEMO_MEASURE_SEED_HEX=
DEMO_MEASURE_CALLBACK_TEXT=latency-run
DEMO_MEASURE_CALLBACK_HEX=
DEMO_TARGET_P95_MS=2000
