# IOTA Mainnet Node Configuration
# Copy to `iota/node/.env` and replace every placeholder before starting the node.

# IOTA Network
IOTA_RPC_URL=https://api.mainnet.iota.cafe

# Published coordinator package
COORDINATOR_PACKAGE_ID=0xc871ca37099f0d2fa47b4e9ed0b0b18b8f03cf9ac3bd3da60f5b788e69265126
COORDINATOR_OBJECT_ID=0xREPLACE_AFTER_CREATE_COORDINATOR

# Fastcrypto CLI
# Docker uses /usr/local/bin/ecvrf-cli automatically.
# Local runs should use the vendored, pinned CLI:
#   cd ../fastcrypto && cargo build --locked --release --bin ecvrf-cli
FASTCRYPTO_CLI_PATH=../fastcrypto/target/release/ecvrf-cli

# VRF proving key
# Choose exactly one mode:
# 1. Fill VRF_SECRET_KEY and VRF_PUBLIC_KEY directly, or
# 2. Leave them blank and provide VRF_KEYPAIR_PATH, or
# 3. Leave direct/path blank and provide VRF_KEYPAIR_COMMAND that prints:
#    {"secretKey":"<32-byte-hex>","publicKey":"<32-byte-hex>"}
# Docker path-based mode expects docker-compose.file-secrets.yml and the default filename below.
# AWS Secrets Manager mode: use docker-compose.aws.yml and set VRF_KEYPAIR_COMMAND below.
VRF_SECRET_KEY=
VRF_PUBLIC_KEY=
VRF_KEYPAIR_PATH=
VRF_KEYPAIR_COMMAND=aws secretsmanager get-secret-value --secret-id kamui/iota/vrf-keypair --query SecretString --output text

# Operator signer
# Choose exactly one mode:
# 1. Fill OPERATOR_PRIVATE_KEY directly, or
# 2. Leave it blank and provide OPERATOR_KEYPAIR_PATH, or
# 3. Leave direct/path blank and provide OPERATOR_KEY_COMMAND that prints either:
#    {"privateKey":"<32-byte-hex>"} or the raw 32-byte hex private key
# Docker path-based mode expects docker-compose.file-secrets.yml and the default filename below.
# AWS Secrets Manager mode: use docker-compose.aws.yml and set OPERATOR_KEY_COMMAND below.
OPERATOR_PRIVATE_KEY=
OPERATOR_KEYPAIR_PATH=
OPERATOR_KEY_COMMAND=aws secretsmanager get-secret-value --secret-id kamui/iota/operator-key --query SecretString --output text

# Local state
STATE_DIR=./state

# Ops server
# Docker keeps ops private by default; use docker-compose.public-ops.yml to publish.
OPS_HOST=127.0.0.1
OPS_PORT=9464

# Polling + retry tuning
POLL_INTERVAL_MS=500
BACKFILL_WINDOW_SEC=30
EVENT_PAGE_SIZE=50
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RPC_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
RPC_CIRCUIT_BREAKER_COOLDOWN_MS=30000
